server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 25m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api {
        return 308 /api/;
    }

    location = /api/meetings {
        proxy_pass ${MEETINGS_UPSTREAM};
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location ^~ /api/meetings/ {
        proxy_pass ${MEETINGS_UPSTREAM};
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location ^~ /api/ {
        # No trailing slash: preserve /api/, the endpoint and query string.
        proxy_pass ${API_UPSTREAM};
        include /etc/nginx/snippets/api-proxy.conf;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|mp4|woff2?|pdf)$ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
