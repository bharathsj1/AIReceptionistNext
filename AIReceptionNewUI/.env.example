# URL of the function host (used by Vite dev proxy)
VITE_FUNCTION_HOST=http://localhost:7071
# VITE_FUNCTION_HOST=https://smartconnect4u-func.azurewebsites.net

# Base path for API calls from the React app (keep /api to use the proxy)
VITE_API_PROXY_BASE=/api

# Optional development-only setup: sign in -> business details -> crawl/review -> dashboard.
# Requires a localhost frontend in Vite dev mode with the same-origin /api proxy.
# Production builds ignore this flag. No subscriptions, payments or numbers are created.
VITE_LOCAL_SKIP_PAYMENT=false

# Next.js public API base (must include /api when targeting Functions directly)
# NEXT_PUBLIC_API_BASE=https://smartconnect4u-func.azurewebsites.net/api
# NEXT_PUBLIC_FUNCTION_HOST=https://smartconnect4u-func.azurewebsites.net

# Dedicated Jitsi meetings function app
VITE_JITSI_API_BASE=https://smartconnect4u-jitsi-eugahzaha5hcdefa.westeurope-01.azurewebsites.net/api
NEXT_PUBLIC_JITSI_API_BASE=https://smartconnect4u-jitsi-eugahzaha5hcdefa.westeurope-01.azurewebsites.net/api
