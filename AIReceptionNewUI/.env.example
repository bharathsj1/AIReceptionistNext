# Server-side Vite development proxies. Docker uses Nginx container upstreams.
# Browser API URLs always use /api on the same origin.
BACKEND_UPSTREAM=http://127.0.0.1:7071
MEETINGS_UPSTREAM=http://127.0.0.1:7072

# Optional development-only setup: sign in -> business details -> crawl/review -> dashboard.
# Requires a localhost frontend in Vite dev mode with the same-origin /api proxy.
# Production builds ignore this flag. No subscriptions, payments or numbers are created.
VITE_LOCAL_SKIP_PAYMENT=false

# Jitsi video UI domain (independent from the Docker meetings API).
VITE_JITSI_DOMAIN=meet.jit.si
