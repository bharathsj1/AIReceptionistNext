# Run: python3 scripts/configure_docker.py
# This creates .env.docker at the root and fills missing signing/encryption secrets.
# Docker Compose supplies Blob/Queue/Table endpoints for the internal azurite service.
# No cloud storage connection strings are needed.

# Compose fixes this SQLite path on backend-data, overriding retired database URLs.
DATABASE_URL=sqlite:////data/app.db
SOCIAL_UPLOAD_DIR=/data/social_uploads
DB_INIT_STRICT=true

# Use the externally reachable HTTPS origin when deploying.
# API_PUBLIC_BASE_URL is the origin WITHOUT /api.
API_PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Add integration settings from your existing deployment as needed:
# Twilio, Ultravox, Stripe, Google/Outlook OAuth, SMTP and AI providers.
# Preserve SOCIAL_TOKEN_ENC_KEY when moving an existing database; changing it
# makes previously encrypted social tokens unreadable. Never put secrets in VITE_*.

# VedoraEats AI outreach. Existing provider values can be reused.
# Keep credentials in server environment settings only.
AUTH_SESSION_SECRET=
SOCIAL_TOKEN_ENC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ULTRAVOX_API_KEY=
OUTREACH_TOOL_SECRET=
OUTREACH_ULTRAVOX_VOICE=
FROM_EMAIL=support@vedoraeats.com

# Verification codes and lead summaries share this SMTP configuration.
# Alternatively save it securely in Calling setup → Email delivery settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Optional approved Twilio regulatory details, keyed by the account owner's email.
# Use each customer's own approved bundle/address, never shared identity defaults.
# OUTREACH_NUMBER_REGULATORY_SETTINGS={"owner@example.com":{"bundle_sid":"BU...","address_sid":"AD..."}}

# Customer billing. Configure a dedicated signed callback from Billing & wallet
# as bharath.sj1@gmail.com, or supply its signing secret here. Preserve
# AUTH_SESSION_SECRET: it also encrypts a callback secret stored in SQLite.
STRIPE_SECRET_KEY=
# OUTREACH_STRIPE_WEBHOOK_SECRET=whsec_...
# 1 credit = 1 GBP penny. Customers start at zero balance.
# Number rental is always 2x the current Twilio monthly quote, rounded up to 1p.
# Call pricing defaults to 2x Twilio + Ultravox combined per-minute cost.
OUTREACH_CALL_MARKUP_MODE=combined
# Alternative if charging 2x Twilio only: OUTREACH_CALL_MARKUP_MODE=twilio_only
OUTREACH_ULTRAVOX_COST_PER_MINUTE=0.05
OUTREACH_ULTRAVOX_COST_CURRENCY=USD
# Currency conversion uses current ECB rates, refusing data older than 7 days.
# Optional operator-managed conversion override (GBP for 1 USD):
# OUTREACH_USD_GBP_RATE=
