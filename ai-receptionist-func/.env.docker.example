# Run: python3 scripts/configure_docker.py
# This creates .env.docker at the root and fills missing signing/encryption secrets.
# Docker Compose supplies Blob/Queue/Table endpoints for the internal azurite service.
# No cloud storage connection strings are needed.

# Compose fixes this SQLite path on backend-data, overriding retired database URLs.
DATABASE_URL=sqlite:////data/app.db
SOCIAL_UPLOAD_DIR=/data/social_uploads
DB_INIT_STRICT=true

# Use the externally reachable HTTPS origin when deploying.
# API_PUBLIC_BASE_URL is the origin WITHOUT /api.
API_PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Add integration settings from your existing deployment as needed:
# Twilio, Ultravox, Stripe, Google/Outlook OAuth, SMTP and AI providers.
# Preserve SOCIAL_TOKEN_ENC_KEY when moving an existing database; changing it
# makes previously encrypted social tokens unreadable. Never put secrets in VITE_*.

# VedoraEats AI outreach. Existing provider values can be reused.
# Keep credentials in server environment settings only.
AUTH_SESSION_SECRET=
SOCIAL_TOKEN_ENC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ULTRAVOX_API_KEY=
OUTREACH_TOOL_SECRET=
OUTREACH_ULTRAVOX_VOICE=
SENDGRID_API_KEY=
FROM_EMAIL=
